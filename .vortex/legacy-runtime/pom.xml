<?xml version="1.0" encoding="UTF-8"?>
<!-- Build wrapper for PIT over the legacy Ant tree. Unverified: not run (no JDK/Maven here). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>legacy</groupId>
  <artifactId>petstore-pit</artifactId>
  <version>1.3.2</version>
  <properties>
    <legacySource>../../legacy-source</legacySource>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
  </properties>
  <build>
    <sourceDirectory>${legacySource}/app/src</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.15.8</version>
        <configuration>
          <outputFormats><outputFormat>XML</outputFormat></outputFormats>
          <failWhenNoMutations>false</failWhenNoMutations>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
