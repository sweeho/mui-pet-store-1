  PROFILE { varchar profile_id PK  varchar preferred_language }
  CUSTOMER { varchar user_id PK,FK  varchar account_id FK  varchar profile_id FK }
  PURCHASE_ORDER { varchar po_id PK  number po_date  number po_value  varchar contact_id FK  varchar card_id FK }
  PO_LINE_ITEM { varchar po_id PK,FK  varchar line_number PK  int quantity  int quantity_shipped }
  ORDER_MANAGER { varchar order_id PK  varchar status }
  SUPPLIER_ORDER { varchar po_id PK  varchar po_status  varchar contact_id FK }
  SUPPLIER_LINE_ITEM { varchar po_id PK,FK  varchar line_number PK  int quantity }
  INVENTORY { varchar item_id PK  int quantity }
  COUNTER { varchar name PK  int counter }
