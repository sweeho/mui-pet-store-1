  CATEGORY { varchar catid PK }
  CATEGORY_DETAILS { varchar catid PK,FK  varchar locale PK  varchar name }
  PRODUCT { varchar productid PK  varchar catid FK }
  PRODUCT_DETAILS { varchar productid PK,FK  varchar locale PK  varchar name }
  ITEM { varchar itemid PK  varchar productid FK }
  ITEM_DETAILS { varchar itemid PK,FK  varchar locale PK  decimal listprice  decimal unitcost }
  SIGNON_USER { varchar username PK  varchar password }
  ADDRESS { varchar address_id PK }
  CONTACT_INFO { varchar contact_id PK  varchar address_id FK }
  CREDIT_CARD { varchar card_id PK  varchar card_number  varchar expiry_date }
